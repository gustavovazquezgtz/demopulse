generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

// MANAGER/CEO accounts can authenticate; DEVELOPER people are evaluated,
// assigned, and attend demos like anyone else but have no login (passwordHash
// stays null for them) — see section 2 vs section 4 of the product spec.
enum UserRole {
  MANAGER
  CEO
  DEVELOPER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum DemoStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InviteRole {
  EVALUATOR_MANAGER
  ATTENDEE_MANAGER
  ATTENDEE_MEMBER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum DeliverableStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
  PARTIALLY_COMPLETED
}

enum EvaluationStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PerformanceTrend {
  IMPROVING
  STABLE
  DECLINING
  INSUFFICIENT_DATA
}

enum ManagerRecommendation {
  STRONGLY_RECOMMEND
  RECOMMEND
  NEUTRAL
  NEEDS_ATTENTION
  SIGNIFICANT_CONCERN
}

enum UrlType {
  PRODUCTION
  STAGING
  GITHUB
  DOCUMENTATION
  FIGMA
  DEMO_ENV
  OTHER
}

enum InsightSubjectType {
  PERSON
  TEAM
  PROJECT
  ORGANIZATION
}

enum InsightType {
  STRENGTH
  DEVELOPMENT
  RISK
  RECOGNITION
  RECOMMENDATION
  TREND
  SUMMARY
}

enum AlertType {
  PERFORMANCE
  DELIVERY
  AI_ADOPTION
  UX
  BUSINESS_UNDERSTANDING
  ATTENDANCE
  TREND
  RECOGNITION
}

enum AlertSeverity {
  INFORMATIONAL
  LOW
  MEDIUM
  HIGH
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum RecognitionSource {
  AI
  MANAGER
}

// ─────────────────────────────────────────────────────────────────────────
// Employee Bank / Prospecting
// ─────────────────────────────────────────────────────────────────────────

enum EmployeeGroup {
  A
  B
  C
}

enum EmployeeAvailability {
  AVAILABLE
  PARTIALLY_ALLOCATED
  FULLY_ALLOCATED
}

enum ProspectSource {
  INTERNAL_STAFFING
  CLIENT_REQUEST
  MANAGER_RECOMMENDATION
  SALES_OPPORTUNITY
  REPLACEMENT
  OTHER
}

enum ProspectStatus {
  IDENTIFIED
  PROFILE_BEING_PREPARED
  PROFILE_SUBMITTED
  CLIENT_REVIEWING
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  PENDING_DECISION
  ACCEPTED
  REJECTED
  WITHDRAWN
  CANCELLED
  ON_HOLD
}

enum ProspectOutcomeReason {
  TECHNICAL_SKILLS
  ENGLISH
  SENIORITY
  SALARY
  CLIENT_PREFERENCE
  ROLE_MISMATCH
  PROJECT_CANCELLED
  POSITION_FILLED
  AVAILABILITY
  EMPLOYEE_DECLINED
  INTERVIEW_PERFORMANCE
  TIMING
  OTHER
}

// How an attended interview went — distinct from the eventual
// ProspectOutcomeReason (which is "why the whole opportunity failed").
enum InterviewResult {
  WENT_WELL
  WENT_BADLY
}

// Why the person did not attend a scheduled interview at all — distinct
// from InterviewResult (which only applies once they did attend).
enum InterviewNonAttendanceReason {
  SCHEDULING_CONFLICT
  EMPLOYEE_DECLINED
  EMPLOYEE_UNAVAILABLE
  NO_SHOW
  CLIENT_CANCELLED
  OTHER
}

// ─────────────────────────────────────────────────────────────────────────
// People / Org structure
// ─────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String? // null for DEVELOPER people — they cannot authenticate
  role         UserRole
  title        String? // e.g. "Senior Developer" — for developers; managers can be blank
  avatarUrl    String?
  skills       String[] @default([])
  active       Boolean  @default(true)
  dateJoined   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Team relationships
  teamMemberships    TeamMember[]
  teamsManaged       TeamManager[]
  teamManagerHistory TeamManagerHistory[]

  // Project relationships
  projectAssignments ProjectAssignment[]
  projectsManaged    ProjectManager[]

  // Demos
  demosHosted           Demo[]             @relation("HostManager")
  demosCreated          Demo[]             @relation("CreatedBy")
  demosStarted          Demo[]             @relation("StartedBy")
  demoInvitations       DemoInvitee[]
  demoAttendances       DemoAttendee[]     @relation("Attendee")
  deliverableOwnerships DeliverableOwner[]

  // Evaluations — as the developer being evaluated
  evaluationsReceived Evaluation[] @relation("Developer")
  // Evaluations — as the evaluating manager
  evaluationsGiven    Evaluation[] @relation("Evaluator")

  participationGiven    ParticipationScore[] @relation("RatedBy")
  participationReceived ParticipationScore[] @relation("RatedDeveloper")

  opinionsGiven    ManagerOpinion[] @relation("OpinionManager")
  opinionsReceived ManagerOpinion[] @relation("OpinionDeveloper")

  notifications Notification[]
  auditLogs     AuditLog[]

  recognitionsReceived Recognition[] @relation("RecognitionDeveloper")

  // Employee Bank
  employeeBankProfile   EmployeeBankProfile?
  employeeNotesReceived EmployeeNote[]         @relation("EmployeeNoteSubject")
  employeeNotesWritten  EmployeeNote[]         @relation("EmployeeNoteAuthor")
  prospects             EmployeeProspect[]     @relation("ProspectEmployee")
  prospectsOwned        EmployeeProspect[]     @relation("ProspectOwner")
  prospectActivity      ProspectActivity[]
  savedViewsCreated     EmployeeBankSavedView[]

  // 1:1 Sessions
  oneOnOnesAsManager   OneOnOneSession[] @relation("OneOnOneManager")
  oneOnOnesAsDeveloper OneOnOneSession[] @relation("OneOnOneDeveloper")
  oneOnOneNotesWritten OneOnOneNote[]

  scoreCutoff EngineerScoreCutoff?

  @@index([role])
  @@index([active])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  managers       TeamManager[]
  managerHistory TeamManagerHistory[]
  members        TeamMember[]
  projects       ProjectTeam[]
  demos          DemoTeam[]
  evaluations    Evaluation[]
  prospects      EmployeeProspect[]

  @@index([name])
}

model TeamManager {
  id     String @id @default(cuid())
  teamId String
  userId String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
}

// Every stint a manager has had on a team, kept forever — even after
// updateTeamManagers/updateManagerTeams removes the live TeamManager row.
// endedAt null means still actively managing; set once when they're
// replaced, never edited afterward, so Rankings and Team detail can always
// answer "who manages this now" vs "who used to."
model TeamManagerHistory {
  id        String    @id @default(cuid())
  teamId    String
  managerId String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  team    Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  manager User @relation(fields: [managerId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([managerId])
  @@index([teamId, endedAt])
}

// A single membership stint: joinedAt/leftAt (leftAt null = still active).
// No longer unique on (teamId, userId) — a person can be an active member
// of several teams at once, and can leave and later rejoin the same team,
// which needs a second row rather than overwriting the first one's dates.
model TeamMember {
  id       String    @id @default(cuid())
  teamId   String
  userId   String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([teamId])
  @@index([teamId, leftAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Projects
// ─────────────────────────────────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  client      String?
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  managers     ProjectManager[]
  assignments  ProjectAssignment[]
  teams        ProjectTeam[]
  urls         ProjectUrl[]
  demos        DemoProject[]
  deliverables DemoDeliverable[]
  evaluations  Evaluation[]
  prospects    EmployeeProspect[]
  operationsAssignees EmployeeBankProfile[]

  @@index([status])
  @@index([name])
}

model ProjectUrl {
  id        String  @id @default(cuid())
  projectId String
  type      UrlType @default(OTHER)
  label     String
  url       String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectManager {
  id        String @id @default(cuid())
  projectId String
  userId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model ProjectTeam {
  id        String @id @default(cuid())
  projectId String
  teamId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([projectId, teamId])
  @@index([teamId])
  @@index([projectId])
}

// A person assigned to a project. isPrimary marks a person's "primary project"
// (a person can have exactly one primary + many secondary assignments).
model ProjectAssignment {
  id        String    @id @default(cuid())
  projectId String
  userId    String
  isPrimary Boolean   @default(false)
  startDate DateTime  @default(now())
  endDate   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────────────────
// Demos
// ─────────────────────────────────────────────────────────────────────────

model Demo {
  id            String     @id @default(cuid())
  title         String
  description   String?
  date          DateTime
  startTime     DateTime
  endTime       DateTime
  status        DemoStatus @default(SCHEDULED)
  notes         String?
  hostManagerId String
  createdById   String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  reopenedAt    DateTime? // set whenever a COMPLETED session is reopened for edits (section 21 audit trail)
  startedById   String? // the invited manager who actually started the session (Scheduled -> In Progress)
  startedAt     DateTime?

  hostManager User  @relation("HostManager", fields: [hostManagerId], references: [id])
  createdBy   User  @relation("CreatedBy", fields: [createdById], references: [id])
  startedBy   User? @relation("StartedBy", fields: [startedById], references: [id])

  // A demo can involve multiple teams presenting together (e.g. two squads
  // sharing a session) and, correspondingly, multiple projects.
  teams         DemoTeam[]
  projects      DemoProject[]
  urls          DemoUrl[]
  invitees      DemoInvitee[]
  attendees     DemoAttendee[]
  deliverables  DemoDeliverable[]
  evaluations   Evaluation[]
  participation ParticipationScore[]

  @@index([hostManagerId])
  @@index([date])
  @@index([status])
}

model DemoTeam {
  id     String @id @default(cuid())
  demoId String
  teamId String

  demo Demo @relation(fields: [demoId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([demoId, teamId])
  @@index([demoId])
  @@index([teamId])
}

model DemoProject {
  id        String @id @default(cuid())
  demoId    String
  projectId String

  demo    Demo    @relation(fields: [demoId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([demoId, projectId])
  @@index([demoId])
  @@index([projectId])
}

model DemoUrl {
  id     String  @id @default(cuid())
  demoId String
  type   UrlType @default(OTHER)
  label  String
  url    String

  demo Demo @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId])
}

// Invitation list captured at scheduling time — distinct from actual attendance.
model DemoInvitee {
  id     String     @id @default(cuid())
  demoId String
  userId String
  role   InviteRole

  demo Demo @relation(fields: [demoId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([demoId, userId, role])
  @@index([demoId])
  @@index([userId])
}

model DemoAttendee {
  id         String           @id @default(cuid())
  demoId     String
  userId     String
  status     AttendanceStatus @default(PRESENT)
  recordedAt DateTime         @default(now())

  demo Demo @relation(fields: [demoId], references: [id], onDelete: Cascade)
  user User @relation("Attendee", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([demoId, userId])
  @@index([demoId])
  @@index([userId])
}

// "Unofficial Participation Indicators" — separate from the official evaluation.
model ParticipationScore {
  id            String   @id @default(cuid())
  demoId        String
  developerId   String
  ratedById     String
  participation Int // 1-5
  engagement    Int
  commitment    Int
  communication Int
  preparedness  Int
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  demo      Demo @relation(fields: [demoId], references: [id], onDelete: Cascade)
  developer User @relation("RatedDeveloper", fields: [developerId], references: [id], onDelete: Cascade)
  ratedBy   User @relation("RatedBy", fields: [ratedById], references: [id], onDelete: Cascade)

  @@unique([demoId, developerId, ratedById])
  @@index([demoId])
  @@index([developerId])
}

model DemoDeliverable {
  id              String            @id @default(cuid())
  demoId          String
  projectId       String
  title           String
  description     String?
  expectedOutcome String?
  status          DeliverableStatus @default(NOT_STARTED)
  urls            String[]          @default([])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  demo    Demo               @relation(fields: [demoId], references: [id], onDelete: Cascade)
  project Project            @relation(fields: [projectId], references: [id])
  owners  DeliverableOwner[]

  @@index([demoId])
  @@index([projectId])
}

model DeliverableOwner {
  id            String @id @default(cuid())
  deliverableId String
  userId        String

  deliverable DemoDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deliverableId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Evaluations (configurable criteria — not hardcoded questions)
// ─────────────────────────────────────────────────────────────────────────

model EvaluationCriterion {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. "delivery", "complexity", "business", "ux", "ai_usage", "english"
  text      String // the exact question wording shown to managers
  dimension String // short label used in charts: Delivery, Complexity, Business, UX, AI, English
  order     Int      @default(0)
  weight    Float    @default(1)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  answers EvaluationAnswer[]

  @@index([active])
}

model Evaluation {
  id                  String           @id @default(cuid())
  demoId              String
  developerId         String
  evaluatorId         String
  projectId           String // which project this evaluation pertains to (developer may be on multiple)
  teamId              String? // the developer's team AT THE TIME of this evaluation — a permanent historical
  // snapshot, so moving someone to a different team later never rewrites which team a past score belongs to.
  status              EvaluationStatus @default(NOT_STARTED)
  overallComment      String?
  strengths           String?
  areasForImprovement String?
  score               Float? // cached on completion — formula depends on scoringVersion, never recomputed retroactively
  // 1 = legacy yes/no criteria (pre-cutoff). 2 = 1-5 scale with dynamic
  // per-criterion weights (from the methodology cutoff date onward). Set
  // once when the evaluation is first created and never changed — editing
  // an old evaluation later must keep scoring it the way it always was,
  // never silently reinterpreted under the new rubric.
  scoringVersion      Int              @default(1)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  demo      Demo    @relation(fields: [demoId], references: [id], onDelete: Cascade)
  developer User    @relation("Developer", fields: [developerId], references: [id], onDelete: Cascade)
  evaluator User    @relation("Evaluator", fields: [evaluatorId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id])
  team      Team?   @relation(fields: [teamId], references: [id])

  answers EvaluationAnswer[]

  // one evaluation per (manager, developer, demo) — rule #3
  @@unique([demoId, developerId, evaluatorId])
  @@index([developerId])
  @@index([evaluatorId])
  @@index([demoId])
  @@index([createdAt])
}

model EvaluationAnswer {
  id           String  @id @default(cuid())
  evaluationId String
  criterionId  String
  // Legacy (scoringVersion 1): the real yes/no answer. New (scoringVersion
  // 2): derived as scaleValue >= 3 so every existing "% positive" chart
  // and AI-insight reader keeps working unchanged — the REAL new score
  // comes from scaleValue + the criterion's weight, not from this flag.
  answer       Boolean
  // 1-5 rating, populated only for scoringVersion-2 answers. Null for
  // every legacy answer — never backfilled, never reinterpreted.
  scaleValue   Int?
  comment      String?

  evaluation Evaluation          @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  EvaluationCriterion @relation(fields: [criterionId], references: [id])

  @@unique([evaluationId, criterionId])
  @@index([evaluationId])
}

// Manager Opinion — distinct from the demo evaluation. One evolving record
// per (manager, developer) pair; history captured via AuditLog.
model ManagerOpinion {
  id             String                @id @default(cuid())
  developerId    String
  managerId      String
  strengths      String?
  concerns       String?
  growthAreas    String?
  confidence     Int // 1-5
  trend          PerformanceTrend      @default(INSUFFICIENT_DATA)
  recommendation ManagerRecommendation @default(NEUTRAL)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  developer User @relation("OpinionDeveloper", fields: [developerId], references: [id], onDelete: Cascade)
  manager   User @relation("OpinionManager", fields: [managerId], references: [id], onDelete: Cascade)

  @@unique([developerId, managerId])
  @@index([developerId])
  @@index([managerId])
}

// ─────────────────────────────────────────────────────────────────────────
// AI layer
// ─────────────────────────────────────────────────────────────────────────

model AiInsight {
  id          String             @id @default(cuid())
  subjectType InsightSubjectType
  subjectId   String? // null for ORGANIZATION-level insights
  type        InsightType
  title       String
  body        String
  evidence    Json // structured "why am I seeing this" data
  createdAt   DateTime           @default(now())

  @@index([subjectType, subjectId])
  @@index([type])
  @@index([createdAt])
}

model AiAlert {
  id          String             @id @default(cuid())
  type        AlertType
  severity    AlertSeverity
  status      AlertStatus        @default(ACTIVE)
  subjectType InsightSubjectType
  subjectId   String
  title       String
  description String
  evidence    Json
  createdAt   DateTime           @default(now())
  resolvedAt  DateTime?

  @@index([subjectType, subjectId])
  @@index([status])
  @@index([severity])
}

model Recognition {
  id           String            @id @default(cuid())
  developerId  String
  title        String
  body         String
  evidence     Json
  source       RecognitionSource @default(AI)
  acknowledged Boolean           @default(false)
  createdAt    DateTime          @default(now())

  developer User @relation("RecognitionDeveloper", fields: [developerId], references: [id], onDelete: Cascade)

  @@index([developerId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Notifications & Auditability
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  entityType String
  entityId   String
  action     String // CREATE | UPDATE | DELETE
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Employee Bank / Prospecting
// ─────────────────────────────────────────────────────────────────────────

// 1:1 extension of a DEVELOPER User. Never duplicates fields User (or its
// existing relations) already has — name/title/team/project all come from
// there. Lazily created on first edit; no row yet just means "not yet
// classified," not a data-integrity gap to backfill.
//
// No "rating" field: the staffing rating is the developer's live demo
// evaluation score (averageScore over their Evaluation rows), never
// manually captured — it's computed on read, not stored here.
model EmployeeBankProfile {
  id                String               @id @default(cuid())
  userId            String               @unique
  group             EmployeeGroup? // the manager's final call — never auto-written by any suggestion logic
  groupOverrideNote String? // required by the UI when group disagrees with the suggested group
  availability      EmployeeAvailability @default(AVAILABLE)
  currentSalary     Float?
  proposedSalary    Float?
  action            String? // free text: "Place", "Maintain", "Evaluate", "Review", ...
  justification     String?
  // "Dar de alta" — this person was placed on a real client account. When
  // operationsProjectId is set, a matching ProjectAssignment is created so
  // this shows up consistently everywhere else in the app (People,
  // Ranking, Team rosters) — this flag never exists only here.
  assignedToOperations   Boolean   @default(false)
  assignedToOperationsAt DateTime?
  operationsProjectId    String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  operationsProject Project? @relation(fields: [operationsProjectId], references: [id])
}

model EmployeeNote {
  id        String   @id @default(cuid())
  userId    String // the employee this note is about
  authorId  String
  type      String // GENERAL | STAFFING | PROSPECT | EVALUATION | MANAGER
  text      String
  createdAt DateTime @default(now())

  user   User @relation("EmployeeNoteSubject", fields: [userId], references: [id], onDelete: Cascade)
  author User @relation("EmployeeNoteAuthor", fields: [authorId], references: [id])

  @@index([userId])
}

// An employee being considered for a project/team/client. Never deleted —
// "did not materialize" is a status + outcome reason, not a removed row,
// so future staffing decisions can see the full history.
model EmployeeProspect {
  id                String                  @id @default(cuid())
  employeeId        String
  client            String?
  projectId         String?
  teamId            String?
  role              String
  ownerManagerId    String
  source            ProspectSource
  status            ProspectStatus          @default(IDENTIFIED)
  interviewDate     DateTime?
  expectedStartDate DateTime?
  // Whether the person actually showed up for `interviewDate`, and how it
  // went. Separate from the overall `status`/`outcomeReason` below — an
  // interview can go badly without the whole opportunity being over yet
  // (another round, a different role), and a no-show has its own reason
  // distinct from "why the opportunity ultimately failed."
  interviewAttended            Boolean?
  interviewResult              InterviewResult?
  interviewNonAttendanceReason InterviewNonAttendanceReason?
  interviewNonAttendanceNotes  String?
  outcomeReason     ProspectOutcomeReason?
  outcomeNotes      String?
  technicalFeedback String?
  englishFeedback   String?
  clientFeedback    String?
  generalNotes      String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  employee User     @relation("ProspectEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id])
  team     Team?    @relation(fields: [teamId], references: [id])
  owner    User     @relation("ProspectOwner", fields: [ownerManagerId], references: [id])

  activity ProspectActivity[]

  @@index([employeeId])
  @@index([status])
  @@index([ownerManagerId])
}

// The prospect's permanent timeline — every status change, note, and
// feedback entry. Never deleted, mirroring the Evaluation/TeamMember/
// TeamManager history pattern already used throughout this app.
model ProspectActivity {
  id         String   @id @default(cuid())
  prospectId String
  actorId    String
  action     String // CREATE | STATUS_CHANGE | NOTE | FEEDBACK | OUTCOME
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  prospect EmployeeProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  actor    User             @relation(fields: [actorId], references: [id])

  @@index([prospectId])
}

model EmployeeBankSavedView {
  id          String   @id @default(cuid())
  name        String
  filters     Json // serialized filter/sort/column-visibility state
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id])
}

// Generic key-value settings store — starts with Employee Bank's group
// rating thresholds, reusable for future configurable settings.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// 1:1 Sessions (manager <-> developer check-ins)
// ─────────────────────────────────────────────────────────────────────────

enum OneOnOneFormat {
  IN_PERSON
  VIDEO_CALL // Teams/Zoom/Meet/etc. — kept generic rather than one enum value per tool
  PHONE_CALL
  CHAT
  OTHER
}

// A single logged 1:1. Nothing here is write-once: recommendations,
// feedback, format, even the summary can all be edited later — the
// "bitácora" is the AuditLog trail (via ActivityLog) plus the append-only
// OneOnOneNote list, not immutability of the session itself.
model OneOnOneSession {
  id               String         @id @default(cuid())
  managerId        String
  developerId      String
  date             DateTime
  format           OneOnOneFormat @default(IN_PERSON)
  location         String? // free text detail alongside format: room name, meeting link, etc.
  recommendations  String? // what the manager told/recommended to the person
  feedbackReceived String? // what the manager heard back from the person
  summary          String? // AI-generated (or manually edited) summary
  summarySource    String? // provider name ("openai" | "rule-based") that produced the current summary text, or null if never generated
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  manager   User @relation("OneOnOneManager", fields: [managerId], references: [id])
  developer User @relation("OneOnOneDeveloper", fields: [developerId], references: [id])

  recordings OneOnOneRecording[]
  notes      OneOnOneNote[]

  @@index([managerId])
  @@index([developerId])
  @@index([date])
}

// Audio is stored directly (Bytes/bytea) — fine at this org's scale and
// recording-length cap (short voice clips, capped client-side and by
// next.config's serverActions.bodySizeLimit to stay under common
// serverless request-body limits). A session can have several recordings
// rather than one, so a long 1:1 can be captured in segments.
model OneOnOneRecording {
  id          String    @id @default(cuid())
  sessionId   String
  audio       Bytes
  mimeType    String
  sizeBytes   Int
  durationSec Int?
  transcript  String?
  createdAt   DateTime  @default(now())

  session OneOnOneSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// Append-only follow-up additions — "quiero poder... agregar más
// información" without overwriting the original capture.
model OneOnOneNote {
  id        String   @id @default(cuid())
  sessionId String
  authorId  String
  text      String
  createdAt DateTime @default(now())

  session OneOnOneSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author  User             @relation(fields: [authorId], references: [id])

  @@index([sessionId])
}

// ─────────────────────────────────────────────────────────────────────────
// Evaluation methodology cutoff
// ─────────────────────────────────────────────────────────────────────────

// A permanent, one-time snapshot of each developer's score right before
// the evaluation methodology changed (yes/no criteria -> 1-5 scale with
// dynamic weights). Never recalculated, never touched by anything that
// happens afterward — it exists purely so "what was X's score under the
// old system" stays answerable forever, independent of whatever the live
// Score becomes as new-methodology evaluations accumulate.
model EngineerScoreCutoff {
  id               String   @id @default(cuid())
  userId           String   @unique
  cutoffDate       DateTime // the last day counted under the old methodology
  legacyScore      Float // averageScore over every evaluation through cutoffDate
  evaluationCount  Int
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
